{
  "name": "cuy-undc",
  "version": "0.1.8",
  "description": "CLI que despierta a Cuy UNDC en tu escritorio",
  "license": "MIT",
  "keywords": [
    "electron",
    "desktop-pet",
    "cli",
    "undc"
  ],
  "bin": {
    "cuy-undc": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:desktop": "node ./scripts/bundle-desktop.mjs",
    "pack:cli": "npm run build --workspace=@cuy-undc/desktop && npm run build && npm run bundle:desktop",
    "prepack": "npm run pack:cli",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "electron": "^33.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
