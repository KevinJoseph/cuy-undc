{
  "name": "@cuy-undc/desktop",
  "version": "0.1.7",
  "description": "Electron desktop pet for Cuy UNDC",
  "license": "MIT",
  "author": "Cuy UNDC",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron dist/main/index.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "prepare:app": "node ./scripts/prepare-app-dir.mjs",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:win": "npm run build && npm run prepare:app && electron-builder --win nsis portable",
    "dist:dir": "npm run build && npm run prepare:app && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "pe.net.cuy-undc.desktop",
    "electronVersion": "33.0.0",
    "productName": "Cuy UNDC",
    "directories": {
      "app": "app",
      "output": "release",
      "buildResources": "build-resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KevinJoseph",
        "repo": "cuy-undc"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Cuy UNDC",
      "runAfterFinish": true
    }
  }
}
